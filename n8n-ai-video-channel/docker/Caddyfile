# Replace n8n.example.com with your real domain. Caddy will auto-provision
# a Let's Encrypt certificate on first request.

{$N8N_HOST:n8n.example.com} {
    encode zstd gzip

    # Forward to the n8n container
    reverse_proxy n8n:5678 {
        flush_interval -1
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote}
    }

    # Reasonable defaults
    request_body {
        max_size 500MB
    }

    log {
        output stdout
        format console
    }
}

# =============================================================================
# AI Video Channel - Environment Variables Template
# Copy to .env and fill in real values. NEVER commit the real .env to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# n8n core settings
# -----------------------------------------------------------------------------
GENERIC_TIMEZONE=UTC
TZ=UTC
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.com/
N8N_EDITOR_BASE_URL=https://n8n.example.com/

# Basic auth (also set up a real reverse proxy in production)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_to_a_long_random_string

# Encryption key for credentials at rest. MUST be set BEFORE first run and never changed.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# Execution behavior - keeps long-running Veo polls reliable
EXECUTIONS_MODE=regular
EXECUTIONS_PROCESS=main
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# Postgres (recommended for production over SQLite)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=change_me_postgres_password

# -----------------------------------------------------------------------------
# Schedule (CRON expression - editable without touching the workflow)
# Default: 8 AM, 1 PM, 7 PM every day
# -----------------------------------------------------------------------------
CRON_SCHEDULE=0 8,13,19 * * *

# -----------------------------------------------------------------------------
# Gemini API (idea + prompt + metadata generation)
# Get a key: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIza...your_gemini_api_key
GEMINI_TEXT_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Google Vertex AI - Veo (video generation)
# -----------------------------------------------------------------------------
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
# Veo model id - update as Google releases new versions
VEO_MODEL_ID=veo-3.0-generate-preview
# GCS bucket where Veo writes generated videos. Bucket must exist and the
# service account must have roles/storage.objectAdmin on it.
VERTEX_OUTPUT_BUCKET=your-gcs-bucket-name
# How many 30s polls before giving up (40 = 20 min)
VEO_MAX_POLL_ATTEMPTS=40

# -----------------------------------------------------------------------------
# Google Service Account (covers Sheets, Drive, Vertex AI, GCS)
# Path is INSIDE the n8n container (docker-compose mounts it).
# Configure inside n8n as: Credentials -> Google API -> Service Account ->
# paste the JSON content. The file path is here only for reference.
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/home/node/secrets/service-account.json

# -----------------------------------------------------------------------------
# Google Sheets - the master spreadsheet for ideas, videos, logs
# Create a new spreadsheet, share it with the service account email,
# then paste its ID here (the long string in the URL between /d/ and /edit).
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_DOCUMENT_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_ExampleSheetId

# -----------------------------------------------------------------------------
# Google Drive - destination folder for generated videos
# Right-click the folder in Drive -> Share with the service account email,
# then copy the folder id from the URL.
# -----------------------------------------------------------------------------
GDRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_ExampleFolderId
GDRIVE_DRIVE_ID=My Drive

# -----------------------------------------------------------------------------
# YouTube Data API v3 - configured as OAuth2 inside n8n credentials,
# but the channel ID is referenced here for clarity.
# -----------------------------------------------------------------------------
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Facebook Graph API - Reels upload
# Use a long-lived Page access token with pages_manage_posts +
# pages_read_engagement + publish_video scopes.
# -----------------------------------------------------------------------------
FB_PAGE_ID=1234567890
FB_PAGE_ACCESS_TOKEN=EAAB...your_long_lived_page_token

# -----------------------------------------------------------------------------
# Error handler - sub-workflow id (paste after importing 02-error-handler.json)
# -----------------------------------------------------------------------------
ERROR_HANDLER_WORKFLOW_ID=

# -----------------------------------------------------------------------------
# Notifications on repeated failure
# Slack/Discord webhook + transactional email
# -----------------------------------------------------------------------------
MAX_RETRY_ATTEMPTS=3
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
NOTIFY_FROM_EMAIL=alerts@yourdomain.com
NOTIFY_TO_EMAIL=you@yourdomain.com

# SMTP (used by error-handler email node) - configure inside n8n credentials
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=change_me

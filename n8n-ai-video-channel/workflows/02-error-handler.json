{
  "name": "AI Video Channel - Error Handler",
  "nodes": [
    {
      "parameters": {
        "events": ["workflow"]
      },
      "id": "trigger-error",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [-800, 200]
    },
    {
      "parameters": {},
      "id": "trigger-execute",
      "name": "When Called by Main Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-800, 400]
    },
    {
      "parameters": {
        "jsCode": "// Normalize error payload from either Error Trigger or executeWorkflow Trigger\nconst raw = $input.first().json;\nconst execId = raw.execution?.id || raw.executionId || 'n/a';\nconst wfName = raw.workflow?.name || 'AI Video Channel';\nconst stage = raw.stage || raw.execution?.lastNodeExecuted || 'unknown';\nconst errMsg = raw.execution?.error?.message || raw.error || raw.message || JSON.stringify(raw).slice(0, 600);\nconst runId = raw.runId || `err_${Date.now()}`;\nconst stack = raw.execution?.error?.stack || '';\n\n// Retry counter held in execution metadata\nconst retryKey = `retry_${runId}`;\nreturn [{ json: { runId, execId, wfName, stage, errMsg, stack, retryKey, timestamp: new Date().toISOString() } }];"
      },
      "id": "node-normalize",
      "name": "Normalize Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-580, 300]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEETS_DOCUMENT_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "Logs", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $json.timestamp }}",
            "run_id": "={{ $json.runId }}",
            "level": "ERROR",
            "stage": "={{ $json.stage }}",
            "message": "={{ $json.errMsg }}",
            "details": "={{ JSON.stringify({ execId: $json.execId, wf: $json.wfName, stack: $json.stack }).slice(0, 1500) }}"
          }
        }
      },
      "id": "node-log-error",
      "name": "Log Error to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-360, 300],
      "credentials": {
        "googleApi": { "id": "google-service-account", "name": "Google Service Account" }
      }
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "read",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEETS_DOCUMENT_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "RetryCounter", "mode": "name" },
        "filtersUI": {
          "values": [
            { "lookupColumn": "run_id", "lookupValue": "={{ $json.runId }}" }
          ]
        },
        "options": { "returnFirstMatch": true }
      },
      "id": "node-read-retry",
      "name": "Read Retry Counter",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [-140, 300],
      "credentials": {
        "googleApi": { "id": "google-service-account", "name": "Google Service Account" }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const err = $('Normalize Error').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.run_id);\nconst current = rows[0]?.attempts ? parseInt(rows[0].attempts) : 0;\nconst nextAttempt = current + 1;\nconst maxRetries = parseInt($env.MAX_RETRY_ATTEMPTS || '3');\nconst shouldRetry = nextAttempt <= maxRetries;\nconst shouldNotify = nextAttempt >= maxRetries;\nreturn [{ json: { ...err, currentAttempts: current, nextAttempt, maxRetries, shouldRetry, shouldNotify, hasRow: rows.length > 0 } }];"
      },
      "id": "node-decide",
      "name": "Decide Retry / Notify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.hasRow }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-has-row",
      "name": "Existing Counter?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [300, 300]
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "update",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEETS_DOCUMENT_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "RetryCounter", "mode": "name" },
        "columnToMatchOn": "run_id",
        "valueToMatchOn": "={{ $json.runId }}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $json.runId }}",
            "attempts": "={{ $json.nextAttempt }}",
            "last_stage": "={{ $json.stage }}",
            "last_error": "={{ $json.errMsg }}",
            "updated_at": "={{ $json.timestamp }}"
          }
        }
      },
      "id": "node-update-counter",
      "name": "Update Counter",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [520, 200],
      "credentials": {
        "googleApi": { "id": "google-service-account", "name": "Google Service Account" }
      }
    },
    {
      "parameters": {
        "authentication": "serviceAccount",
        "operation": "append",
        "documentId": { "__rl": true, "value": "={{ $env.GOOGLE_SHEETS_DOCUMENT_ID }}", "mode": "id" },
        "sheetName": { "__rl": true, "value": "RetryCounter", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "run_id": "={{ $json.runId }}",
            "attempts": "={{ $json.nextAttempt }}",
            "last_stage": "={{ $json.stage }}",
            "last_error": "={{ $json.errMsg }}",
            "updated_at": "={{ $json.timestamp }}"
          }
        }
      },
      "id": "node-insert-counter",
      "name": "Insert Counter",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [520, 400],
      "credentials": {
        "googleApi": { "id": "google-service-account", "name": "Google Service Account" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.shouldNotify }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-notify",
      "name": "Notify Threshold?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOTIFY_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \":rotating_light: AI Video Channel pipeline FAILED ({{ $json.nextAttempt }}/{{ $json.maxRetries }} attempts)\\n*Run ID:* {{ $json.runId }}\\n*Stage:* {{ $json.stage }}\\n*Error:* {{ $json.errMsg }}\\n*Time:* {{ $json.timestamp }}\"\n}",
        "options": { "timeout": 15000 }
      },
      "id": "node-notify-slack",
      "name": "Notify Slack/Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.NOTIFY_FROM_EMAIL }}",
        "toEmail": "={{ $env.NOTIFY_TO_EMAIL }}",
        "subject": "[ALERT] AI Video Channel Pipeline Failure - Run {{ $json.runId }}",
        "emailFormat": "html",
        "html": "=<h2 style='color:#cc0000'>Pipeline Failure</h2>\n<p><b>Run ID:</b> {{ $json.runId }}</p>\n<p><b>Stage:</b> {{ $json.stage }}</p>\n<p><b>Attempt:</b> {{ $json.nextAttempt }} / {{ $json.maxRetries }}</p>\n<p><b>Time:</b> {{ $json.timestamp }}</p>\n<pre style='background:#f4f4f4;padding:10px;border-radius:4px'>{{ $json.errMsg }}</pre>\n<p>Check the Logs tab in Google Sheets for full context.</p>",
        "options": {}
      },
      "id": "node-notify-email",
      "name": "Notify Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 400],
      "credentials": {
        "smtp": { "id": "smtp-cred", "name": "SMTP" }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [[{ "node": "Normalize Error", "type": "main", "index": 0 }]]
    },
    "When Called by Main Workflow": {
      "main": [[{ "node": "Normalize Error", "type": "main", "index": 0 }]]
    },
    "Normalize Error": {
      "main": [[{ "node": "Log Error to Sheets", "type": "main", "index": 0 }]]
    },
    "Log Error to Sheets": {
      "main": [[{ "node": "Read Retry Counter", "type": "main", "index": 0 }]]
    },
    "Read Retry Counter": {
      "main": [[{ "node": "Decide Retry / Notify", "type": "main", "index": 0 }]]
    },
    "Decide Retry / Notify": {
      "main": [[{ "node": "Existing Counter?", "type": "main", "index": 0 }]]
    },
    "Existing Counter?": {
      "main": [
        [{ "node": "Update Counter", "type": "main", "index": 0 }],
        [{ "node": "Insert Counter", "type": "main", "index": 0 }]
      ]
    },
    "Update Counter": {
      "main": [[{ "node": "Notify Threshold?", "type": "main", "index": 0 }]]
    },
    "Insert Counter": {
      "main": [[{ "node": "Notify Threshold?", "type": "main", "index": 0 }]]
    },
    "Notify Threshold?": {
      "main": [
        [
          { "node": "Notify Slack/Discord", "type": "main", "index": 0 },
          { "node": "Notify Email", "type": "main", "index": 0 }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "tags": [{ "name": "ai-video-channel" }, { "name": "error-handler" }],
  "active": false,
  "versionId": "1.0.0"
}

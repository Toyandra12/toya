# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinenova?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- App ---
NEXT_PUBLIC_APP_NAME="CineNova"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="NPR"

# --- Cloudinary (optional, for product images) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Payment gateways (optional) ---
ESEWA_MERCHANT_CODE=""
ESEWA_SECRET=""
KHALTI_PUBLIC_KEY=""
KHALTI_SECRET_KEY=""

# --- Default seeded admin (used by prisma/seed.ts) ---
SEED_ADMIN_EMAIL="admin@cinenova.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

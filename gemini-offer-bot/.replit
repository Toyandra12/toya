run = "bash run.sh"
entrypoint = "bot.py"
language = "python3"

[nix]
channel = "stable-23_11"

[env]
PYTHONUNBUFFERED = "1"
# Chrome/ChromeDriver paths are auto-detected at runtime via shutil.which.
# You only need to set these manually if auto-detection fails.
# CHROME_BINARY_PATH = ""
# CHROMEDRIVER_PATH  = ""

[deployment]
run = ["sh", "-c", "bash run.sh"]
deploymentTarget = "cloudrun"

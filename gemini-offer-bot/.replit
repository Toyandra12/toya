run = "python bot.py"
entrypoint = "bot.py"
language = "python3"

[nix]
channel = "stable-23_11"

[env]
PYTHONUNBUFFERED = "1"
CHROMEDRIVER_PATH = "/nix/store/.../bin/chromedriver"
CHROME_BINARY_PATH = "/nix/store/.../bin/chromium"

[deployment]
run = ["sh", "-c", "python bot.py"]
deploymentTarget = "cloudrun"
